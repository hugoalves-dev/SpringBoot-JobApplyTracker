COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

DB_URL=jdbc:mariadb://mariadb:3306/jobtracker
DB_NAME=jobtracker
DB_USERNAME=jobtracker
DB_PASSWORD=sua_senha_forte_aqui

JWT_SECRET=seu_segredo_jwt_super_seguro
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=https://applywell.hugojava.dev

# WebAuthn / passkeys (production)
# RP IDs are part of the credential scope. Changing this value later requires users
# whose passkeys were registered under a different RP ID to register a new passkey.
APP_WEBAUTHN_RP_ID=applywell.hugojava.dev
APP_WEBAUTHN_RP_NAME=ApplyWell
APP_WEBAUTHN_ORIGIN_1=https://applywell.hugojava.dev

OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
PROMETHEUS_URL=http://prometheus:9090
TRACING_SAMPLING_PROBABILITY=1.0

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=11
MAIL_PASSWORD=11
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_FROM=no-reply@example.com

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/api/v1/google-drive/oauth/callback
GOOGLE_DRIVE_OAUTH_COMPLETE_URL=http://localhost:5173/settings/google-drive/callback

# Ask ApplyWell: choose none (disabled), google-genai (Gemini), or openai (OpenRouter).
APP_ASSISTANT_ENABLED=false
# This is the Spring AI ChatModel provider ID: openai uses OpenRouter's compatible API.
APP_ASSISTANT_PROVIDER=none
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose an OpenRouter model that supports streaming and tool calling.
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

OPENAI_GPT_CLIENT_ID=
OPENAI_GPT_CLIENT_SECRET=
OPENAI_GPT_REDIRECT_URIS=https://chat.openai.com/aip/default/callback
OPENAI_GPT_SCOPES=read:profile,read:applications,write:applications,read:resume,read:google-drive,read:metrics
